# Google Cloud Project Configuration
PROJECT_ID=your-gcp-project-id
REGION=europe-west3

# Cloud Storage Buckets
SOURCE_BUCKET=your-gcp-project-id-receipts-processed
SUBMITTED_BUCKET=your-gcp-project-id-receipts-submitted
FAILED_BUCKET=your-gcp-project-id-receipts-failed

# BigQuery Analytics Configuration
BIGQUERY_DATASET=receipts_processing
BIGQUERY_TABLE=processing_results

# Typeform Form Endpoint
TYPEFORM_URL=https://egym.typeform.com/to/z5XBrNXf

# Member Information
EMAIL=member@example.com
FIRST_NAME=Max
LAST_NAME=Mustermann
IBAN=DE12345678901234567890
BIC=GENODEM1GLS

# Execution Settings
DRY_RUN=true
HEADLESS=true
TARGET_MONTH=
SCREENSHOTS_DIR=/tmp/form-submission-screenshots

# Deployment & Service Accounts
ARTIFACT_REGISTRY_REPOSITORY=golang
JOB_NAME=form-submission-job
SCHEDULER_JOB_NAME=monthly-form-submission-trigger
CRON_SCHEDULE="0 8 2 * *"
TIME_ZONE="Europe/Berlin"
SUBMISSION_JOB_SERVICE_ACCOUNT=form-submission-job-sa@your-gcp-project-id.iam.gserviceaccount.com
SCHEDULER_JOB_SERVICE_ACCOUNT=scheduler-job-invoker-sa@your-gcp-project-id.iam.gserviceaccount.com

