# Google Cloud Project Configuration
PROJECT_ID=your-gcp-project-id
REGION=europe-west3

# Cloud Storage Buckets (All Required)
SOURCE_BUCKET=your-incoming-receipts-bucket
TARGET_BUCKET=your-processed-receipts-bucket
FAILED_BUCKET=your-failed-receipts-bucket

# Gemini Model Configuration
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_GENAI_USE_VERTEXAI=true

# Optional: Gemini API Key (if using Google AI Studio instead of Vertex AI ADC)
# GEMINI_API_KEY=your-gemini-api-key

# Server Port (for local development)
PORT=8080

# Cloud Functions Deployment Settings
FUNCTION_NAME=process-receipt
RUNTIME=go126
ARTIFACT_REGISTRY_REPOSITORY=golang
