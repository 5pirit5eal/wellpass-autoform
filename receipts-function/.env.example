# Google Cloud Project Configuration
PROJECT_ID=your-gcp-project-id
REGION=europe-west3
GEMINI_LOCATION=eu

# Cloud Storage Buckets (All Required)
SOURCE_BUCKET=your-gcp-project-id-receipts-unprocessed
TARGET_BUCKET=your-gcp-project-id-receipts-processed
FAILED_BUCKET=your-gcp-project-id-receipts-failed

# BigQuery Analytics Configuration
BIGQUERY_DATASET=receipts_processing
BIGQUERY_TABLE=processing_results

# Gemini Model Configuration
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_GENAI_USE_VERTEXAI=true

# Optional: Gemini API Key (if using Google AI Studio instead of Vertex AI ADC)
# GEMINI_API_KEY=your-gemini-api-key

# Server Port (for local development)
PORT=8080

# Cloud Functions Deployment Settings
FUNCTION_NAME=process-receipt
RUNTIME=go126
ARTIFACT_REGISTRY_REPOSITORY=golang
FUNCTION_SERVICE_ACCOUNT=receipts-function-sa@your-gcp-project-id.iam.gserviceaccount.com
